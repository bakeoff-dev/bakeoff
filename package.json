{
  "name": "bakeoff-cli",
  "version": "0.1.0",
  "description": "Race coding agents on your real issues. Merge the winner.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bakeoff-dev/bakeoff.git"
  },
  "homepage": "https://github.com/bakeoff-dev/bakeoff#readme",
  "keywords": [
    "ai",
    "agents",
    "claude-code",
    "codex",
    "gemini-cli",
    "cursor",
    "benchmark",
    "evaluation",
    "github",
    "pull-request",
    "cli"
  ],
  "type": "module",
  "bin": {
    "bakeoff": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "bun run src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:ui": "vite build --config ui/vite.config.ts && mv dist/index.html dist/ui.html",
    "build:cli": "bun scripts/build-cli.ts",
    "build": "bun run build:ui && bun run build:cli",
    "prepublishOnly": "bun run test && bun run typecheck && bun run build"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@resvg/resvg-js": "^2.6.2",
    "commander": "^15.0.0",
    "openskill": "^5.0.1",
    "satori": "^0.33.4",
    "yaml": "^2.8.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.2.0"
  }
}
